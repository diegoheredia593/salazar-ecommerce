---
import Imagen from '../components/Imagen.astro';
import Sucursales from '../components/Sucursales.astro';
import TituloResaltado from '../components/TituloResaltado.astro';
import Base from '../layouts/Base.astro';
import { contenido } from '../lib/content/contenido';

const c = await contenido();
const sucursales = await c.coleccion('sucursales');
const foto = c.foto('nosotros.hero.foto');
---
<Base titulo={c.texto('nosotros.seo.titulo')} descripcion={c.texto('nosotros.seo.descripcion')} imagen={foto}>
  <section class:list={['hero', { 'con-foto': Boolean(foto) }]}>
    {foto && <Imagen foto={foto} class="hero-foto" prioritaria sizes="100vw" />}
    <div class="contenedor hero-texto">
      <TituloResaltado texto={c.texto('nosotros.hero.titulo')} nivel="h1" class="hero-titulo" />
      <p>{c.texto('nosotros.hero.texto')}</p>
    </div>
  </section>
  <section class="contenedor seccion">
    <div class="prosa" set:html={c.rico('nosotros.historia.texto')} />
  </section>
  {
    sucursales.length > 0 && (
      <section class="contenedor seccion" aria-labelledby="titulo-sucursales">
        <h2 id="titulo-sucursales" class="titulo-seccion espacio">Visítanos</h2>
        <Sucursales sucursales={sucursales} />
      </section>
    )
  }
</Base>

<style>
  .hero { position: relative; background: var(--gris-tarjeta); min-height: 300px; display: flex; align-items: center; overflow: hidden; }
  :global(.hero-foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .con-foto::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0) 70%); }
  .hero-texto { position: relative; z-index: 2; display: grid; gap: 16px; padding-block: 48px; }
  .hero-texto > * { max-width: 620px; }
  :global(.hero-titulo) { font-size: clamp(2.25rem, 1.6rem + 2.8vw, 3.75rem); }
  .hero-texto p { font-size: 1.125rem; }
  .espacio { margin-bottom: 20px; }
</style>
