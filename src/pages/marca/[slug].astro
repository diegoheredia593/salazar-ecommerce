---
import Filtros from '../../components/Filtros.astro';
import Imagen from '../../components/Imagen.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import Base from '../../layouts/Base.astro';
import { contenido, ricoDe } from '../../lib/content/contenido';
import { categoriasTienda, filtrar, filtrosDeUrl, todosLosProductos } from '../../lib/tienda/catalogo';
import { tienda } from '../../lib/tienda/fuente';

const c = await contenido();
const marcas = await c.coleccion('marcas');
const marca = marcas.find((m) => m.slug === Astro.params.slug);
if (!marca) return Astro.rewrite('/404');

const t = await tienda();
const [categorias, catalogo] = await Promise.all([categoriasTienda(t), todosLosProductos(t)]);
const filtros = { ...filtrosDeUrl(Astro.url), marca: marca.slug };
const deMarca = filtrar(catalogo, { marca: marca.slug }, marcas);
const productos = filtrar(catalogo, filtros, marcas);
const categoriasDeMarca = categorias.filter((x) => deMarca.some((p) => p.categoria?.slug === x.slug));
const descripcion = ricoDe(marca.descripcion);
---
<Base titulo={marca.nombre} descripcion={marca.frase ?? undefined} imagen={marca.fotoBanner ?? marca.logo} noIndexar={Astro.url.search !== ''}>
  <div class="contenedor">
    <nav class="migas" aria-label="Estás en">
      <ol><li><a href="/">Inicio</a></li><li><a href="/marca">{c.texto('marca.encabezado.titulo')}</a></li><li aria-current="page">{marca.nombre}</li></ol>
    </nav>
    <header class:list={['banner', `fondo-${marca.fondo ?? 'oscuro'}`]}>
      {marca.fotoBanner && <Imagen foto={marca.fotoBanner} class="banner-foto" prioritaria sizes="100vw" />}
      <div class="banner-texto">
        {marca.logo ? <Imagen foto={marca.logo} alt={marca.nombre} class="banner-logo" sizes="200px" /> : null}
        <h1 class:list={['titulo-seccion', { 'solo-lectores': Boolean(marca.logo) }]}>{marca.nombre}</h1>
        {marca.frase && <p class="frase">{marca.frase}</p>}
      </div>
    </header>
    {descripcion && <div class="prosa descripcion" set:html={descripcion} />}

    <div class="disposicion">
      <aside aria-label="Filtros">
        <Filtros accion={`/marca/${marca.slug}`} filtros={filtros} categorias={categoriasDeMarca} marcas={[]} />
      </aside>
      <section aria-label={`Productos ${marca.nombre}`}>
        <p class="cantidad" role="status">{productos.length === 1 ? '1 producto' : `${productos.length} productos`}</p>
        {
          productos.length > 0 ? (
            <ul class="grilla-productos">{productos.map((p) => <li><TarjetaProducto producto={p} marca={marca.nombre} /></li>)}</ul>
          ) : (
            <p class="vacio">{c.texto('marca.vacio.texto')}</p>
          )
        }
        <p class="nota-iva">{c.texto('global.footer.notaPrecios')}</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .banner { position: relative; overflow: hidden; border-radius: var(--radio-grande); min-height: 200px; display: flex; align-items: center; }
  .fondo-oscuro { background: linear-gradient(120deg, #0d0d0d, #2b2420); color: var(--blanco); }
  .fondo-azul { background: linear-gradient(120deg, #0c1f3d, #173a6b); color: var(--blanco); }
  .fondo-claro { background: var(--gris-tarjeta); }
  :global(.banner-foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .banner:has(:global(.banner-foto))::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(0 0 0 / 0.7), rgb(0 0 0 / 0) 70%); }
  .banner-texto { position: relative; z-index: 2; padding: 32px; display: grid; gap: 12px; }
  :global(.banner-logo) { max-height: 56px; width: auto; }
  .banner h1:not(.solo-lectores) { font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); font-weight: 900; text-transform: uppercase; }
  .frase { font-size: 1.25rem; font-weight: 600; }
  .descripcion { margin-top: 24px; }
  .disposicion { display: grid; gap: 20px; margin-top: 32px; }
  @media (min-width: 1024px) { .disposicion { grid-template-columns: 240px 1fr; gap: 40px; align-items: start; } }
  .cantidad { color: var(--gris-texto); font-size: 0.9375rem; margin-bottom: 12px; }
  .vacio { padding: 48px 16px; text-align: center; background: var(--gris-fondo); border-radius: var(--radio); }
</style>
