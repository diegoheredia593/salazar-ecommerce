---
import FormularioPlataforma from '../components/FormularioPlataforma.astro';
import Icono from '../components/Icono.astro';
import Sucursales from '../components/Sucursales.astro';
import Base from '../layouts/Base.astro';
import { contenido } from '../lib/content/contenido';
import { enlaceWhatsapp } from '../lib/sitio';

const c = await contenido();
const sucursales = await c.coleccion('sucursales');
const wa = enlaceWhatsapp(c.texto('global.contacto.whatsapp'), c.texto('global.contacto.mensajeWhatsapp'));
const mapa = c.texto('contacto.mapa.enlace');
---
<Base titulo={c.texto('contacto.seo.titulo')} descripcion={c.texto('contacto.seo.descripcion')}>
  <div class="contenedor">
    <nav class="migas" aria-label="Estás en"><ol><li><a href="/">Inicio</a></li><li aria-current="page">{c.texto('contacto.encabezado.titulo')}</li></ol></nav>
    <header class="cabecera">
      <h1 class="titulo-seccion">{c.texto('contacto.encabezado.titulo')}</h1>
      <p class="subtitulo-seccion">{c.texto('contacto.encabezado.texto')}</p>
      <div class="atajos">
        {wa && <a class="boton boton-wa" href={wa} rel="noopener"><Icono nombre="whatsapp" tamano={20} />{c.texto('global.encabezado.botonWhatsapp')}</a>}
        {mapa && <a class="boton boton-borde" href={mapa} rel="noopener"><Icono nombre="ubicacion" tamano={20} />Cómo llegar</a>}
      </div>
    </header>

    <div class="formularios">
      <section class="tarjeta-formulario" aria-labelledby="titulo-contacto">
        <h2 id="titulo-contacto">Escríbenos</h2>
        <FormularioPlataforma tipo="contacto" boton="Enviar mensaje" exito="¡Gracias! Recibimos tu mensaje y te responderemos pronto." />
      </section>
      <section class="tarjeta-formulario" aria-labelledby="titulo-cotizacion">
        <h2 id="titulo-cotizacion">{c.texto('contacto.cotizacion.titulo')}</h2>
        <p class="bajada">{c.texto('contacto.cotizacion.texto')}</p>
        <FormularioPlataforma tipo="cotizacion" boton="Pedir cotización" exito="¡Gracias! Te enviaremos la cotización lo antes posible." />
      </section>
    </div>

    {
      sucursales.length > 0 && (
        <section class="seccion" aria-labelledby="titulo-sucursales">
          <h2 id="titulo-sucursales" class="titulo-seccion espacio">Nuestras sucursales</h2>
          <Sucursales sucursales={sucursales} />
        </section>
      )
    }
  </div>
</Base>

<style>
  .cabecera { display: grid; gap: 12px; margin-bottom: 28px; }
  .atajos { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .formularios { display: grid; gap: 20px; }
  @media (min-width: 1100px) { .formularios { grid-template-columns: 1fr 1fr; align-items: start; } }
  .tarjeta-formulario { display: grid; gap: 14px; padding: 24px; border: 1px solid var(--gris-linea); border-radius: var(--radio-grande); }
  .tarjeta-formulario h2 { font-size: 1.375rem; font-weight: 800; }
  .bajada { color: var(--gris-texto); }
  .espacio { margin-bottom: 20px; }
</style>
